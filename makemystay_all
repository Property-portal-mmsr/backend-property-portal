# Unified Nginx Config for makemystay.ai
# Handling Main Site, Admin Portal, and API Subdomain separately
# After edits: sudo nginx -t && sudo systemctl reload nginx

# --- www → apex redirect ---
server {
    listen 80;
    server_name www.makemystay.ai;

    location = /health {
        access_log off;
        return 200 'healthy\n';
        add_header Content-Type text/plain;
    }

    return 301 https://makemystay.ai$request_uri;
}

# Main Website (Primary Domain)
server {
    listen 80;
    server_name makemystay.ai;

    location = /health {
        access_log off;
        return 200 'healthy\n';
        add_header Content-Type text/plain;
    }

    # Next hashed chunks — serve from release
    location /_next/static/ {
        alias /var/www/react-app/.next/static/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Public root files
    location ~* ^/(robots\.txt|sitemap\.xml|manifest\.json|logo\.svg|version\.json)$ {
        root /var/www/react-app/public;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600";
    }

    # Proxy /api/* to FastAPI backend
    location /api/ {
        client_max_body_size 10m;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 🛡️ EXPLICIT AUTH PASS: Standard Nginx pattern for Bearer tokens
        proxy_set_header Authorization $http_authorization;
    }

    # Proxy everything else to Next.js on port 3000
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# Admin Portal (Dedicated Subdomain)
server {
    listen 80;
    server_name admin.makemystay.ai;

    root /var/www/makemystay-admin;
    index index.html;

    location = /health {
        access_log off;
        return 200 'healthy\n';
        add_header Content-Type text/plain;
    }

    # Proxy /api/* to FastAPI backend
    location /api/ {
        client_max_body_size 10m;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 🛡️ EXPLICIT AUTH PASS: Standard Nginx pattern for Bearer tokens
        proxy_set_header Authorization $http_authorization;
    }

    location /assets/ {
        root /var/www/makemystay-admin;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    # Prevent stale HTML during rolling deploys.
    location = /index.html {
        try_files $uri =404;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# API Subdomain (Dedicated Subdomain)
server {
    listen 80;
    server_name api.makemystay.ai;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 🛡️ EXPLICIT AUTH PASS
        proxy_set_header Authorization $http_authorization;
    }
}

# -------------------------------------------------------------------
# Employee Portal Frontend: employee.makemystay.ai -> port 3005
# -------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name employee.makemystay.ai;

    location = /health {
        access_log off;
        return 200 "healthy
";
        add_header Content-Type text/plain;
    }

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }
}

