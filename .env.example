DB_HOST=localhost
DB_PORT=3306
DB_NAME=property_portal
DB_USER=root
DB_PASSWORD=password

SECRET_KEY=your-secret

CORS_ORIGINS=http://localhost:3000

# Optional. When set, missing local uploads are fetched from this origin.
# Use this for local dev against a remote database whose files are on the API host.
# UPLOADS_FALLBACK_ORIGIN=https://employee-api.makemystay.ai

# Prefix leftover relative /uploads paths so every teammate hits the API host.
# PUBLIC_UPLOADS_BASE_URL=https://employee-api.makemystay.ai

# Shared CloudFront/S3 photo storage (same bucket as the main MakeMyStay site).
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=makemystayrealty
# CLOUDFRONT_DOMAIN=d1yfdszs9lcm9e.cloudfront.net
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
