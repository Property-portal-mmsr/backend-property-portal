# Nginx Configuration Snippet for MakeMyStay Realty Employee Portal
#
# Since your existing /etc/nginx/sites-available/makemystay_all already serves:
#   - makemystay.ai
#   - admin.makemystay.ai
#   - api.makemystay.ai (FastAPI on Port 8000)
#
# You ONLY need to add this single server block to /etc/nginx/sites-available/makemystay_all
# for the new Employee Portal on Port 3005:

server {
    listen 80;
    server_name employee.makemystay.ai;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
